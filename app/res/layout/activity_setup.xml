<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff101010"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_title"
            android:textColor="#ffffffff"
            android:textSize="20sp" />

        <TextView
            style="@style/Overhear.SetupSection"
            android:layout_marginTop="0dp"
            android:text="@string/setup_section_account" />

        <!-- Read only: スマホで認証 (LoginActivity) is the only way to change these. -->
        <TextView
            android:id="@+id/key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/client_id_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="14sp" />

        <!-- Log out takes effect at once, not on save; the button shows only while logged in. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spotify_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#ffffffff"
                android:textSize="14sp" />

            <Button
                android:id="@+id/spotify_logout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_spotify_logout"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/phone_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_phone_explain"
            android:textColor="#ffaaaaaa"
            android:textSize="12sp" />

        <TextView
            style="@style/Overhear.SetupSection"
            android:layout_marginTop="16dp"
            android:text="@string/setup_section_playback" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                        android:text="@string/setup_name_label"
            android:textColor="#ffffffff"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:maxLength="40"
            android:singleLine="true"
            android:textSize="14sp" />

        <!-- Edit mode only (from the player); takes effect at once, not on save. -->
        <TextView
            android:id="@+id/service_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_service_label"
            android:textColor="#ffffffff"
            android:textStyle="bold"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/service_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/service_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#ffffffff"
                android:textSize="14sp" />

            <Button
                android:id="@+id/service_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/auto_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_auto_start"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_idle_stop_label"
            android:textColor="#ffffffff"
            android:textStyle="bold"
            android:textSize="13sp" />

        <!-- Entries: R.array.setup_idle_stop_entries (SetupActivity). -->
        <Spinner
            android:id="@+id/idle_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp" />

        <!-- Shown only when an equalizer app handles the control panel intent. -->
        <Button
            android:id="@+id/equalizer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setup_equalizer"
            android:visibility="gone" />

        <TextView
            style="@style/Overhear.SetupSection"
            android:layout_marginTop="16dp"
            android:text="@string/setup_section_display" />

        <CheckBox
            android:id="@+id/fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="@string/setup_fullscreen"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setup_save" />

        <Button
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_cancel"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#ffaaaaaa"
            android:textSize="13sp" />

        <!-- Pushes the licence link to the bottom when the form is short. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/licenses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:text="@string/licenses"
            android:textColor="#ffffffff"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="#ff8f8f8f"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Not scrollable: the QR code takes the height left over (QrView keeps
     itself square within it), so everything fits on a 320x480 screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff101010"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/login_title"
        android:textColor="#ffffffff"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_explain"
        android:textColor="#ffffffff"
        android:textSize="13sp" />

    <com.potkc.overhear.QrView
        android:id="@+id/qr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#ffaaaaaa"
        android:textSize="13sp" />

    <Button
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/login_cancel" />
</LinearLayout>

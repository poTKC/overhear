<?xml version="1.0" encoding="utf-8"?>
<!-- The library: a bar (back, page title, reload), the search box on the
     search page only, and the list; colours as in the player's queue panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff1c1c1c"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <TextView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_round_bg"
            android:contentDescription="@string/library_back"
            android:gravity="center"
            android:text="@string/library_back_glyph"
            android:textColor="#ffffffff"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/reload"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_round_bg"
            android:contentDescription="@string/library_reload"
            android:gravity="center"
            android:text="@string/library_reload_glyph"
            android:textColor="#ffaaaaaa"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Searches only on the keyboard's search key (each search uses quota). -->
    <EditText
        android:id="@+id/query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:hint="@string/library_search_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:singleLine="true"
        android:textColor="#ffffffff"
        android:textColorHint="#ff777777"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#22ffffff"
        android:dividerHeight="1px"
        android:fadingEdge="vertical"
        android:listSelector="@drawable/holo_g_list_selector_holo_dark" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#ffaaaaaa"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>

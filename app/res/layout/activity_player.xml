<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait 320x480 mdpi: everything fits without scrolling, with or without the status bar. -->
<!-- The root's background is replaced in code by the cover-coloured gradient (ArtColor). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ff101010">

    <LinearLayout
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="4dp">

        <!-- Full screen only (the status bar is hidden): time left, battery right. -->
        <LinearLayout
            android:id="@+id/top_strip"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#ffb8b8b8"
                android:includeFontPadding="false"
                android:textSize="13sp" />

            <View
                android:id="@+id/battery_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginRight="5dp" />

            <TextView
                android:id="@+id/battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#ffb8b8b8"
                android:includeFontPadding="false"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/artwork"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/artwork"
            android:scaleType="fitXY" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center_horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:textColor="#ffffffff"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:singleLine="true"
            android:textColor="#ffaaaaaa"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Thin track (4 dp) in a 32 dp touch area: the 8 dp vertical padding
             leaves a 16 dp content height (the thumb's), which AbsSeekBar
             centres the track in; the 8 dp side padding is the thumb offset, so
             the thumb is never clipped and the track ends line up with the times. -->
        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingBottom="8dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:progressDrawable="@drawable/seek_track"
            android:thumb="@drawable/seek_thumb"
            android:thumbOffset="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="left"
                android:textColor="#ffb3b3b3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:textColor="#ffb3b3b3"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Shuffle and repeat on the sides, play/pause emphasised in the middle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/shuffle"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_round_bg"
                android:contentDescription="@string/shuffle"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shuffle_state" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/prev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_round_bg"
                android:contentDescription="@string/prev"
                android:scaleType="centerInside"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/play_pause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="@null"
                android:contentDescription="@string/play_pause"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play_button" />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_round_bg"
                android:contentDescription="@string/next"
                android:scaleType="centerInside"
                android:src="@drawable/ic_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/repeat"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:background="@drawable/btn_round_bg"
                android:contentDescription="@string/repeat"
                android:scaleType="centerInside"
                android:src="@drawable/ic_repeat_levels" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Room for the bottom row, which sits over the queue panel. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- The queue: slides up over the player. -->
    <LinearLayout
        android:id="@+id/queue_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="36dp"
        android:background="@drawable/queue_panel_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/queue_header"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/queue_handle"
                android:drawablePadding="4dp"
                android:gravity="left"
                android:text="@string/queue_title"
                android:textColor="#ffffffff"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/queue_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_round_bg"
                android:contentDescription="@string/close"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ListView
            android:id="@+id/queue_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:listSelector="@drawable/holo_g_list_selector_holo_dark"
            android:divider="#22ffffff"
            android:dividerHeight="1px"
            android:fadingEdge="vertical" />

        <TextView
            android:id="@+id/queue_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/queue_empty"
            android:textColor="#ffaaaaaa"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
    <!-- Status bottom-left, queue and settings bottom-right; above the queue panel. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:background="#ff101010"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="4dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#ffb3b3b3"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/queue_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_round_bg"
            android:contentDescription="@string/queue"
            android:scaleType="center"
            android:src="@drawable/ic_queue" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_round_bg"
            android:contentDescription="@string/settings"
            android:scaleType="center"
            android:src="@drawable/ic_settings" />
    </LinearLayout>
</FrameLayout>

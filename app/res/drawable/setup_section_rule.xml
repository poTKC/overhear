<?xml version="1.0" encoding="utf-8"?>
<!-- A 1dp grey rule along the bottom of setup's section headers (Overhear.SetupSection):
     a stroked rectangle whose other three sides sit outside the view (API 18 has no
     layer-list item height). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#ff3a3a3a" />
        </shape>
    </item>
</layer-list>

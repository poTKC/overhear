<?xml version="1.0" encoding="utf-8"?>
<!-- App themes. API 18 has no colorAccent, so the widgets point at recoloured
     copies of the AOSP Holo drawables (tools/make_holo_green.py):
     holo_g_* green (#1ED760) for the player, holo_w_* neutral for setup. -->
<resources>

    <!-- The player: list and popup menu rows highlight in green. -->
    <style name="Theme.Overhear" parent="@android:style/Theme.Holo.NoActionBar">
        <item name="android:listChoiceBackgroundIndicator">@drawable/holo_g_list_selector_holo_dark</item>
    </style>

    <!-- Setup: no accent colour, white and light grey instead of Holo blue. -->
    <style name="Theme.Overhear.Setup">
        <item name="android:editTextStyle">@style/Overhear.EditText</item>
        <item name="android:checkboxStyle">@style/Overhear.CheckBox</item>
        <item name="android:buttonStyle">@style/Overhear.Button</item>
        <item name="android:progressBarStyleHorizontal">@style/Overhear.ProgressBar.Horizontal</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/holo_w_list_selector_holo_dark</item>
        <item name="android:selectableItemBackground">@drawable/holo_w_item_background_holo_dark</item>
        <item name="android:textColorHighlight">#55ffffff</item>
        <item name="android:textColorLink">#ffffffff</item>
        <item name="android:textSelectHandleLeft">@drawable/holo_w_text_select_handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/holo_w_text_select_handle_right</item>
        <item name="android:textSelectHandle">@drawable/holo_w_text_select_handle_middle</item>
        <item name="android:alertDialogTheme">@style/Theme.Overhear.Dialog.Neutral</item>
    </style>

    <!-- The licences dialog: white title; Dialogs.neutral() also recolours the
         title divider, which alert_dialog_holo.xml hard-codes to Holo blue. -->
    <style name="Theme.Overhear.Dialog.Neutral" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:windowTitleStyle">@style/Overhear.DialogWindowTitle</item>
        <item name="android:buttonStyle">@style/Overhear.Button</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/holo_w_list_selector_holo_dark</item>
        <item name="android:selectableItemBackground">@drawable/holo_w_item_background_holo_dark</item>
        <item name="android:textColorHighlight">#55ffffff</item>
        <item name="android:windowMinWidthMajor">@android:dimen/dialog_min_width_major</item>
        <item name="android:windowMinWidthMinor">@android:dimen/dialog_min_width_minor</item>
    </style>

    <style name="Overhear.DialogWindowTitle" parent="@android:style/TextAppearance.Holo.DialogWindowTitle">
        <item name="android:textAppearance">@style/Overhear.TextAppearance.DialogWindowTitle</item>
        <!-- Also directly: the parent's own textColor would win over textAppearance. -->
        <item name="android:textColor">#ffffffff</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Overhear.TextAppearance.DialogWindowTitle" parent="@android:style/TextAppearance.Holo.DialogWindowTitle">
        <item name="android:textColor">#ffffffff</item>
    </style>

    <style name="Overhear.EditText" parent="@android:style/Widget.Holo.EditText">
        <item name="android:background">@drawable/holo_w_edit_text_holo_dark</item>
    </style>

    <style name="Overhear.CheckBox" parent="@android:style/Widget.Holo.CompoundButton.CheckBox">
        <item name="android:button">@drawable/holo_w_btn_check_holo_dark</item>
    </style>

    <style name="Overhear.Button" parent="@android:style/Widget.Holo.Button">
        <item name="android:background">@drawable/holo_w_btn_default_holo_dark</item>
    </style>

    <style name="Overhear.ProgressBar.Horizontal" parent="@android:style/Widget.Holo.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/holo_w_progress_horizontal_holo_dark</item>
        <item name="android:indeterminateDrawable">@drawable/holo_w_progress_indeterminate_horizontal_holo</item>
    </style>
</resources>
